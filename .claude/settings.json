{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test *)",
      "Bash(node node_modules/vitest/vitest.mjs run *)",
      "PowerShell(npm.cmd run typecheck)",
      "PowerShell(npm.cmd run build)",
      "PowerShell(npm.cmd test *)",
      "PowerShell(node node_modules/vitest/vitest.mjs run *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm audit fix *)",
      "PowerShell(npm.cmd install *)",
      "PowerShell(npm.cmd uninstall *)",
      "PowerShell(npm.cmd update *)",
      "PowerShell(npm.cmd audit fix *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m pip install *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "Bash(docker *)",
      "PowerShell(docker *)",
      "PowerShell(Start-Process *)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(/.npmrc)",
      "Read(/secrets/**)",
      "Read(/config/credentials.json)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git clean --force*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git branch -D *)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git restore .)",
      "Bash(git restore -- *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean --force*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * -f *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git checkout .)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore .)",
      "PowerShell(git restore -- *)"
    ]
  }
}
