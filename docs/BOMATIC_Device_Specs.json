        "office": 150,
        "warehouse": 250,
        "outdoor": 500
      }
    }
  },
  "stacking_rules": {
    "description": "Deterministic stacking validation rules",
    "rules": [
      {
        "rule": "C9300 (modular uplink): stack cables needed, NO stack kit. Cable SKUs: STACK-T1-50CM, STACK-T1-1M, STACK-T1-3M"
      },
      {
        "rule": "C9300L (fixed uplink): stack kit + stack cables needed. Kit SKU: C9300L-STACK-KIT. Adapters: 2 per switch (C9300L-STACK). Cable on top."
      },
      {
        "rule": "C9300 and C9300L CANNOT be stacked together"
      },
      {
        "rule": "C9300X and C9300 CAN be stacked at StackWise-480"
      },
      {
        "rule": "C9300 higher-scale (C9300-xxUB) must stack with other higher-scale models only"
      },
      {
        "rule": "Max stack members: 8 (all C9300 variants)"
      },
      {
        "rule": "Cable count for ring topology: N cables for N switches (closed loop)"
      },
      {
        "rule": "Cable count for chain topology: N-1 cables for N switches"
      }
    ]
  },
  "psu_rules": {
    "description": "Power supply selection and redundancy rules",
    "rules": [
      {
        "rule": "Redundant PSU = primary + secondary (DIFFERENT SKUs)",
        "example": "PWR-C1-1100WAC-P (primary) + PWR-C1-1100WAC-P/2 (secondary)"
      },
      {
        "rule": "PoE budget increases with higher PSU wattage",
        "example": "C9300-48P: 437W (715W PSU) \u2192 740W (1100W PSU) \u2192 1440W (dual 1100W)"
      },
      {
        "rule": "Data-only switches use 350W PSU \u2014 no PoE budget"
      },
      {
        "rule": "UPOE switches default to 1100W PSU \u2014 higher PoE per port"
      },
      {
        "rule": "FortiGate 201F and above include dual PSU by default"
      },
      {
        "rule": "FortiGate 101F and below: redundant PSU is optional add-on SKU"
      }
    ]
  }
}