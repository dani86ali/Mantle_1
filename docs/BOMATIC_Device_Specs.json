  "sizing_guidelines": {
    "description": "Rules of thumb for device sizing. These become deterministic functions.",
    "switches": {
      "rule": "1 access port per wired user + 1 PoE port per AP/camera/phone. Add 20% headroom.",
      "example": "100 users + 10 APs + 20 phones + 10 cameras = 140 ports \u2192 3x C9300-48P (144 ports)"
    },
    "firewalls": {
      "rule": "Size by NGFW throughput (not firewall throughput \u2014 that's UDP, unrealistic). 1.5x current bandwidth for 3-year growth.",
      "tiers": [
